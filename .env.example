# Add these values to the Environment variables field in your CLion run
# configuration. This C++ program intentionally does not read .env files.

FIREBASE_DATABASE_URL=https://YOUR_DATABASE_NAME.firebaseio.com

# Leave both token variables unset only when using the local emulator or
# temporary public test rules. For protected databases, set exactly one:
# FIREBASE_ACCESS_TOKEN=short-lived-google-oauth2-access-token
# FIREBASE_ID_TOKEN=short-lived-firebase-user-id-token
